FROM python:3.12-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.11.7 /uv /uvx /bin/

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_DEV=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    MTL_SOURCE=/app/runtime \
    MTL_CHECKPOINT=/app/artifacts/checkpoints/n100/checkpoint-300.pt

RUN useradd --create-home --uid 1000 appuser

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --group mtl --extra cpu --no-install-project

COPY runtime ./runtime
COPY src ./src
RUN uv sync --frozen --no-dev --group mtl --extra cpu --no-editable

USER appuser

EXPOSE 8000

CMD ["uvicorn", "vrp_service.serving.app:app", "--host", "0.0.0.0", "--port", "8000"]
